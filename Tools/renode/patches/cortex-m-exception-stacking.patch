+/* Exception entry stacking (ARMv7-M PushStack): the access is checked with the privilege of the
+ * interrupted context, not the handler's, and SP moves to the frame even when a write faults */
+static int v7m_exception_push(CPUState *env, uint32_t val, bool is_user)
+{
+    uint32_t phys_ptr = 0;
+    target_ulong page_size = 0;
+    int ret, prot = 0;
+    uint32_t address = env->regs[13] - 4;
+    ret = get_phys_addr(env, address, env->secure, ACCESS_DATA_STORE, is_user, &phys_ptr, &prot, &page_size, false);
+    env->regs[13] = address;
+    if(ret == TRANSLATE_SUCCESS) {
+        stl_phys(address, val);
+        return 0;
+    }
+    /*  Stacking error - MSTKERR; MMFAR is not valid for it */
+    env->v7m.fault_status[env->secure] |= MEM_FAULT_MSTKERR;
+    return 1;
+}
