# CubeOrangePlus Simulation-on-Hardware with native Rust modules on the Cortex-M4 (experimental).
# Addresses: libraries/AP_RustM4/AP_RustM4_Placement.h
# M4 form: the M7 serves modules running on the Cortex-M4

include ../CubeOrangePlus-SimOnHardWare/hwdef.dat

# the M4 image: last 256 KB of flash (bank 2 sectors 14-15) at 0x081C0000; the M4 Lua
# variant bootloader and BOOT4 0x081C081C stay valid
FLASH_RESERVE_END_KB 256

# D2 SRAM1/2 are the M4's RAM and SRAM3 the shared window: not M7 heap
env USE_ALT_RAM_MAP 1

# build the M4 image and the CubeFramework transport (Tools/ardupilotwaf/cubeframework.py,
# which also defines AP_CUBEFRAMEWORK_ENABLED)
env RUST_M4 1

define AP_SCRIPTING_LUA_ENABLED 0
define AP_SCRIPTING_RUST_ENABLED 1
define AP_RUST_M4_ENABLED 1
# modules run on the M4: no executable memory on the M7
define HAL_EXECUTABLE_MEMORY_ENABLED 0

# per-thread CPU time (ChibiOS statistics): @SYS/threads.txt and the M4 host thread's M4ST.CPU
define HAL_ENABLE_THREAD_STATISTICS 1

# SITL physics on the M7: the aerobatic plane model
define AP_SIM_FRAME_STRING "plane-3d"

undef CHIBIOS_SHORT_BOARD_NAME
define CHIBIOS_SHORT_BOARD_NAME "CubeOrange+SimHW-M4R"
AUTOBUILD_TARGETS Plane
