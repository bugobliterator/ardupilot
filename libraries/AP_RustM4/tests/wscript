#!/usr/bin/env python3
# AP_FLAKE8_CLEAN


def build(bld):
    bld.ap_find_tests(use='ap')
    if not bld.env.HAS_GTEST:
        return
    if 'AP_RUST_M4_ENABLED=1' in bld.env.DEFINES:
        # the M4 service as the M4 image builds it: its bare-name includes and C++17 (CubeFramework)
        try:
            tg = bld.get_tgen_by_name('tests/test_rust_m4_service')
        except Exception:
            tg = None
        if tg is not None:
            tg.source = tg.to_list(tg.source) + [bld.srcnode.find_node('libraries/AP_RustM4/m4/m4_service.cpp')]
            tg.includes = tg.to_list(tg.includes) + [bld.srcnode.find_dir(path).abspath() for path in
                                                     ('libraries/AP_RustM4', 'libraries/AP_RustM4/m4')]
            tg.cxxflags = tg.to_list(getattr(tg, 'cxxflags', [])) + ['-std=gnu++17']
            tg.use = tg.to_list(tg.use) + ['cubeframework']
    try:
        tg = bld.get_tgen_by_name('tests/test_rust_m4_server')
    except Exception:
        tg = None
    if tg is not None:
        # the server with its test hooks; the copy in the ap library has none and is not linked
        tg.source = tg.to_list(tg.source) + [bld.srcnode.find_node('libraries/AP_RustM4/AP_RustM4_Server.cpp')]
        tg.defines = tg.to_list(getattr(tg, 'defines', [])) + ['AP_RUST_M4_TEST_HOOKS=1']
    try:
        tg = bld.get_tgen_by_name('tests/test_rust_m4_module_host')
    except Exception:
        tg = None
    if tg is not None:
        # the M4 loader as the M4 image builds it, against the generated local catalogue
        tg.source = tg.to_list(tg.source) + [
            bld.srcnode.find_node('libraries/AP_RustM4/m4/module_host.cpp'),
            bld.bldnode.find_or_declare('libraries/AP_Rust/BindingLocal_generated.cpp')]
        tg.includes = tg.to_list(tg.includes) + [bld.srcnode.find_dir(path).abspath() for path in
                                                 ('libraries/AP_RustM4', 'libraries/AP_RustM4/m4')]
        tg.cxxflags = tg.to_list(getattr(tg, 'cxxflags', [])) + ['-std=gnu++17']
    try:
        tg = bld.get_tgen_by_name('tests/test_rust_m4_param_mirror')
    except Exception:
        tg = None
    if tg is not None:
        # the server with its test hooks, against a test vehicle's parameter table
        tg.source = tg.to_list(tg.source) + [bld.srcnode.find_node('libraries/AP_RustM4/AP_RustM4_Server.cpp')]
        tg.defines = tg.to_list(getattr(tg, 'defines', [])) + ['AP_RUST_M4_TEST_HOOKS=1']
    try:
        tg = bld.get_tgen_by_name('tests/test_rust_m4_local_math')
    except Exception:
        return   # not a Rust-enabled SITL configuration
    tg.source = tg.to_list(tg.source) + [bld.bldnode.find_or_declare('libraries/AP_Rust/BindingLocal_generated.cpp')]
